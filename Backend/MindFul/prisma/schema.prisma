generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password           String?
  googleId           String?  @unique
  name               String?  @db.VarChar(150)
  picture            String?  @db.Text
  resetToken         String?  @db.VarChar(255)
  resetTokenExpiry   DateTime?
  status             String   @default("offline") @db.VarChar(20)
  lastSeen           DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  journalEntries     JournalEntry[]
  aiConversations    AIConversation[]

  @@map("users")
}

model Admin {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password           String?
  googleId           String?  @unique
  name               String?  @db.VarChar(150)
  picture            String?  @db.Text
  resetToken         String?  @db.VarChar(255)
  resetTokenExpiry   DateTime?
  status             String   @default("offline") @db.VarChar(20)
  lastSeen           DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("admins")
}

model JournalEntry {
  id           Int      @id @default(autoincrement())
  userId       Int
  mood         String   @db.VarChar(50)
  moodEmoji    String   @db.VarChar(10)
  moodColor    String   @db.VarChar(20)
  dateTime     DateTime
  feeling      String   @db.Text
  stressLevel  Int
  energyLevel  Int
  sleepHours   Float
  tags         Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, dateTime])
  @@index([userId, createdAt])
  @@map("journal_entries")
}

model AIConversation {
  id               Int      @id @default(autoincrement())
  userId           Int
  userMessage      String   @db.Text
  aiResponse       String   @db.Text
  isError          Boolean  @default(false)
  entriesAnalyzed  Int      @default(0)
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_conversations")
}